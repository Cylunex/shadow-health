SHADOW_SSO_ENTRY_URL=https://health.example.com
SHADOW_SSO_ALLOWED_GROUPS=health-users,shadow-admins
SHADOW_SSO_LOGOUT_URL=https://auth.example.com/logout?rd=https://health.example.com/
SHADOW_AUTH_MODE=oidc
SHADOW_OIDC_ISSUER=https://auth.example.com
SHADOW_OIDC_CLIENT_ID=shadow-health
SHADOW_OIDC_CLIENT_SECRET_FILE=/etc/shadow-health/secrets/oidc-client-secret
SHADOW_OIDC_REDIRECT_URI=https://health.example.com/auth/callback
SHADOW_OIDC_POST_LOGOUT_REDIRECT_URI=https://health.example.com/
SHADOW_OIDC_REQUIRED_GROUP=health-users
SHADOW_OIDC_SESSION_DB=/data/project/shadow-health/data/web_auth.db
SHADOW_TRUSTED_PROXIES=127.0.0.1/32,::1/128
SHADOW_PROXY_AUTH_SECRET_FILE=/etc/shadow-health/secrets/proxy-auth-secret
