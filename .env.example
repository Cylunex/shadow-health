# 复制为 .env 并填值；一切凭据只存 .env，不进仓库（设计文档 §7.1）
DATABASE_URL=postgresql+psycopg://health_app:CHANGE_ME@127.0.0.1:5432/health_dev
# 浏览器只接受 Shadow Platform SSO；内网旧入口会跳到这个 HTTPS 入口。
SHADOW_SSO_ENTRY_URL=https://health.example.com
SHADOW_SSO_ALLOWED_GROUPS=health-users,shadow-admins
SHADOW_SSO_LOGOUT_URL=https://auth.example.com/logout?rd=https://health.example.com/
SHADOW_AUTH_MODE=oidc
# 仅紧急回滚使用 legacy-forward 时必填；必须带时区且不得超过当前时间 72 小时。
SHADOW_LEGACY_FORWARD_UNTIL=
SHADOW_OIDC_ISSUER=https://auth.example.com
SHADOW_OIDC_CLIENT_ID=shadow-health
SHADOW_OIDC_CLIENT_SECRET_FILE=./secrets/oidc-client-secret
SHADOW_OIDC_REDIRECT_URI=https://health.example.com/auth/callback
SHADOW_OIDC_POST_LOGOUT_REDIRECT_URI=https://health.example.com/
SHADOW_OIDC_REQUIRED_GROUP=health-users
SHADOW_OIDC_SESSION_DB=./data/web_auth.db
# 反向代理与应用同机时保持回环地址；不要为了省事写 0.0.0.0/0。
SHADOW_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# 文件内容与 ECS Nginx 私密 include 中的值一致，至少 32 字符。
SHADOW_PROXY_AUTH_SECRET_FILE=
# 仅本地测试可直接填；生产必须留空并使用上面的受限文件。
SHADOW_PROXY_AUTH_SECRET=
# 各数据采集通道共用的 Bearer 鉴权 token：python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=
# 体脂秤 BLE 网关（可选）：秤的 MAC 过滤，米家 App 设备信息里查；留空收所有 0x181B 广播
MISCALE_MAC=
MISCALE_BINDKEY=
# 存储目录（可选，默认 uploads/ 与 uploads/photos/）
UPLOAD_DIR=
PHOTO_DIR=
# Keep 账号（M4b 可选，未定前留空）
KEEP_MOBILE=
KEEP_PASSWORD=
APP_PORT=8080
# 备份任务连接项（实际值由仓库外配置注入）
BACKUP_PG_HOST=
BACKUP_PG_PORT=5432
BACKUP_PG_DB=shadow_health
BACKUP_PG_USER=health_app
BACKUP_PG_PASSWORD=
# AI 智能分析（可选）：填 Anthropic API Key 后 /ai 页面可用；走代理再设 BASE_URL
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
LLM_MODEL=claude-opus-4-8
# OpenAI 通道（可选）：设置页「AI 模型」可切 provider 并在线填这三项（改完即生效），
# 这里的 .env 值只是设置页留空时的回退；BASE_URL 填兼容端点（DeepSeek/Ollama/oneapi）也走这条
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.1
